# Aísla contenedores, red y volúmenes del resto de laboratorios
COMPOSE_PROJECT_NAME=cacheproxy

# Únicos puertos publicados al host.
# Bloque 18xxx: el taller 2 ya ocupa 8404 y 803.
PUERTO_PROXY=18080
PUERTO_STATS=18404

# Parámetros de caché (se usan desde la semana 13)
CACHE_MAX_ENTRADAS=1000
CACHE_TTL_SEGUNDOS=60
